{
  "title": "Why bread rises",
  "lang": "en", "format": "9:16", "theme": "papercraft",
  "sources": ["https://www.britannica.com/topic/bread/Leavening", "https://www.sciencelearn.org.nz/resources/1804-bread-making-the-science"],
  "scenes": [
    {
      "id": "1-hook", "dur": 5, "bg": "#d4a373",
      "camera": { "move": "push_in", "amount": 0.06 },
      "headline": { "text": "Why bread\nrises", "style": "dark" },
      "caption": "That fluffy loaf is full of *tiny gas bubbles*. Here's who makes them.",
      "elements": [
        { "type": "bread", "x": 540, "y": 930, "scale": 1.3, "rise": { "from": 0.6, "to": 1, "at": 0.4, "dur": 2.6, "ease": "out" }, "enter": "pop" },
        { "type": "bubbles", "x": 540, "y": 860, "w": 560, "h": 260, "count": 16, "color": "#f3e3c3" },
        { "type": "label", "text": "AIR POCKETS", "size": 40, "x": 790, "y": 1160, "rot": 0.05, "enter": { "anim": "pop", "at": 2.4 } }
      ]
    },
    {
      "id": "2-yeast", "dur": 5.5, "bg": "#a3b18a", "transition": "slide",
      "camera": { "move": "parallax", "amount": 30 },
      "caption": "*Yeast*, a tiny living fungus, feeds on the sugars in the flour.",
      "elements": [
        { "type": "paper", "shape": "circle", "r": 330, "x": 540, "y": 900, "color": "#e9dcc3", "enter": "pop" },
        { "type": "paper", "shape": "circle", "depth": 0.7, "loop": { "anim": "bob", "amp": 8 }, "each": [
          { "x": 470, "y": 840, "r": 90, "color": "#d4a373", "enter": { "anim": "pop", "at": 0.4 } },
          { "x": 620, "y": 930, "r": 70, "color": "#c9a27a", "enter": { "anim": "pop", "at": 0.55 } },
          { "x": 520, "y": 1010, "r": 55, "color": "#d4a373", "enter": { "anim": "pop", "at": 0.7 } },
          { "x": 650, "y": 800, "r": 40, "color": "#c9a27a", "enter": { "anim": "pop", "at": 0.85 } }
        ] },
        { "type": "label", "text": "YEAST CELLS", "size": 44, "x": 540, "y": 1290, "rot": -0.03, "enter": { "anim": "rise", "at": 0.9 } },
        { "type": "label", "text": "+ SUGAR", "size": 40, "x": 830, "y": 560, "rot": 0.06, "bg": "#f3e3c3", "enter": { "anim": "pop", "at": 1.6 } }
      ]
    },
    {
      "id": "3-co2", "dur": 5.5, "bg": "#c9ada7",
      "camera": { "move": "tilt", "from": 30, "to": -30 },
      "headline": { "text": "Gas!", "style": "dark" },
      "caption": "As it feeds, it releases *carbon dioxide* gas and a little alcohol.",
      "elements": [
        { "type": "paper", "shape": "rect", "w": 640, "h": 640, "x": 540, "y": 920, "color": "#efe6d6", "enter": "pop" },
        { "type": "bubbles", "x": 540, "y": 920, "w": 560, "h": 560, "count": 34, "color": "#8d99ae", "speed": 1.3 },
        { "type": "molecule", "x": 540, "y": 900, "scale": 0.9, "label": "CO2", "spin": 0.2,
          "atoms": [[0, 0, 46, "#2f2418"], [-115, 0, 40, "#c8553d"], [115, 0, 40, "#c8553d"]], "bonds": [[0, 1], [0, 2]], "enter": { "anim": "pop", "at": 0.8 } },
        { "type": "label", "text": "+ A LITTLE ALCOHOL", "size": 36, "x": 540, "y": 1310, "rot": 0.03, "enter": { "anim": "slide", "from": "left", "at": 1.6 } }
      ]
    },
    {
      "id": "4-gluten", "dur": 5.5, "bg": "#b5838d", "transition": "slide",
      "camera": { "move": "push_in", "amount": 0.07 },
      "headline": { "text": "The gluten\nnet", "style": "dark" },
      "caption": "Kneading builds *gluten*, a stretchy net that *traps the gas*, so the dough puffs up.",
      "elements": [
        { "type": "paper", "shape": "circle", "r": 340, "x": 540, "y": 930, "color": "#f3e3c3", "enter": "pop" },
        { "type": "path", "points": [[300, 760], [460, 700], [620, 790], [780, 720]], "curve": true, "dash": null, "width": 9, "color": "#d4a373", "enter": { "anim": "grow", "at": 0.6, "dur": 1 } },
        { "type": "path", "points": [[300, 930], [470, 1000], [620, 900], [790, 960]], "curve": true, "dash": null, "width": 9, "color": "#d4a373", "enter": { "anim": "grow", "at": 0.9, "dur": 1 } },
        { "type": "path", "points": [[330, 1100], [480, 1050], [640, 1120], [760, 1060]], "curve": true, "dash": null, "width": 9, "color": "#d4a373", "enter": { "anim": "grow", "at": 1.2, "dur": 1 } },
        { "type": "path", "points": [[420, 680], [440, 900], [400, 1120]], "curve": true, "dash": null, "width": 9, "color": "#d4a373", "enter": { "anim": "grow", "at": 1.0, "dur": 1 } },
        { "type": "path", "points": [[660, 700], [640, 920], [680, 1140]], "curve": true, "dash": null, "width": 9, "color": "#d4a373", "enter": { "anim": "grow", "at": 1.3, "dur": 1 } },
        { "type": "bubbles", "x": 540, "y": 930, "w": 480, "h": 460, "count": 14, "color": "#8d99ae", "speed": 0.3 }
      ]
    },
    {
      "id": "5-bake", "dur": 5, "bg": "#d4a373",
      "camera": "static",
      "caption": "In the oven the gas expands, the yeast dies and the alcohol bakes off. *That's the rise.*",
      "elements": [
        { "type": "bread", "x": 540, "y": 960, "scale": 1.45, "rise": { "from": 0.85, "to": 1.12, "at": 0.3, "dur": 2.2, "ease": "out" }, "color": "#b5835a", "enter": "pop" },
        { "type": "label", "text": "~230°C OVEN", "size": 44, "font": "headline", "x": 300, "y": 600, "rot": -0.05, "enter": { "anim": "pop", "at": 0.6 } },
        { "type": "label", "text": "SOURCE: BRITANNICA", "font": "mono", "size": 24, "bg": "#2f2418", "color": "#f7f1e6", "x": 540, "y": 1645, "jitter": 0 }
      ]
    }
  ]
}
