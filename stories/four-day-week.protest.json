{
  "title": "The four-day week experiment",
  "lang": "en", "format": "9:16", "theme": "protest",
  "sources": ["https://autonomy.work/portfolio/uk4dwpilotresults/", "https://www.4dayweek.com/uk-pilot-results"],
  "scenes": [
    {
      "id": "1-hook", "dur": 5, "bg": "#2c5fb3",
      "camera": { "move": "push_in", "amount": 0.07 },
      "headline": { "text": "THE 4-DAY\nWEEK", "style": "light" },
      "caption": "In 2022, *61 UK companies* tried a four-day week with *no pay cut*.",
      "elements": [
        { "type": "calendar", "x": 540, "y": 900, "scale": 1.15, "title": "THIS WEEK", "on": [0, 1, 2, 3], "off": [4], "enter": { "anim": "pop" }, "progress": { "from": 0, "to": 1, "at": 0.6, "dur": 1.6 } },
        { "type": "label", "text": "FRIDAY OFF!", "size": 54, "x": 780, "y": 1180, "rot": 0.08, "bg": "#e63946", "color": "#fff", "enter": { "anim": "stamp", "at": 2.4 } }
      ]
    },
    {
      "id": "2-crowd", "dur": 5, "bg": "#1d3a8a", "transition": "tear",
      "camera": { "move": "parallax", "amount": 35 },
      "caption": "About *2,900 workers* got 100% of the pay for 80% of the time.",
      "elements": [
        { "type": "figure", "y": 1180, "scale": 1.25, "depth": 0.6, "each": [
          { "x": 120, "enter": { "anim": "unfold", "at": 0.1 } }, { "x": 300, "enter": { "anim": "unfold", "at": 0.2 } }, { "x": 480, "enter": { "anim": "unfold", "at": 0.3 } },
          { "x": 660, "enter": { "anim": "unfold", "at": 0.4 } }, { "x": 840, "enter": { "anim": "unfold", "at": 0.5 } }, { "x": 1000, "enter": { "anim": "unfold", "at": 0.6 } }
        ] },
        { "type": "figure", "y": 1300, "scale": 1.5, "each": [{ "x": 210, "enter": { "anim": "unfold", "at": 0.3 } }, { "x": 560, "enter": { "anim": "unfold", "at": 0.45 } }, { "x": 900, "enter": { "anim": "unfold", "at": 0.6 } }] },
        { "type": "label", "size": 58, "loop": { "anim": "sway", "amp": 0.05 }, "each": [
          { "text": "SLEEP IS\nNOT OPTIONAL", "x": 300, "y": 560, "rot": -0.08, "enter": { "anim": "rise", "at": 0.8 } },
          { "text": "100% PAY", "x": 780, "y": 480, "rot": 0.07, "bg": "#e63946", "color": "#fff", "enter": { "anim": "rise", "at": 1.1 } },
          { "text": "80% TIME", "x": 760, "y": 760, "rot": -0.05, "enter": { "anim": "rise", "at": 1.4 } }
        ] }
      ]
    },
    {
      "id": "3-burnout", "dur": 5, "bg": "#2c5fb3",
      "camera": { "move": "pan", "from": 60, "to": -60 },
      "headline": { "text": "LESS\nBURNOUT", "style": "light" },
      "caption": "*71%* of staff said they felt *less burned out* by the end.",
      "elements": [
        { "type": "counter", "x": 540, "y": 860, "value": { "from": 0, "to": 71, "at": 0.3, "dur": 1.6, "ease": "out" }, "pad": 2, "suffix": "%", "suffixAt": 2.0, "size": 260, "enter": "pop" },
        { "type": "label", "text": "FEEL LESS BURNED OUT", "size": 46, "x": 540, "y": 1130, "rot": -0.02, "enter": { "anim": "slide", "from": "left", "at": 0.8 } }
      ]
    },
    {
      "id": "4-sick", "dur": 5.5, "bg": "#1d3a8a",
      "camera": { "move": "push_in", "amount": 0.05 },
      "caption": "Sick days fell by *65%*, and people quitting dropped by *57%*.",
      "elements": [
        { "type": "bars", "x": 540, "y": 1150, "values": [100, 35, 100, 43], "labels": ["SICK\nBEFORE", "AFTER", "QUITS\nBEFORE", "AFTER"], "colors": ["#f3eee2", "#e63946", "#f3eee2", "#e63946"], "barW": 150, "gap": 60, "h": 560, "enter": { "anim": "grow", "dur": 1.6 } },
        { "type": "label", "size": 64, "font": "headline", "bg": "#e63946", "color": "#fff", "each": [
          { "text": "-65%", "x": 370, "y": 500, "rot": -0.06, "enter": { "anim": "stamp", "at": 1.6 } },
          { "text": "-57%", "x": 790, "y": 520, "rot": 0.05, "enter": { "anim": "stamp", "at": 2.0 } }
        ] }
      ]
    },
    {
      "id": "5-kept", "dur": 5.5, "bg": "#2c5fb3", "transition": "whip",
      "camera": "static",
      "shakes": [{ "at": 2.3, "amp": 12 }],
      "headline": { "text": "56 OF 61\nKEPT IT", "style": "light" },
      "caption": "After six months, *56 of the 61 companies* chose to keep the four-day week.",
      "elements": [
        { "type": "calendar", "x": 540, "y": 900, "title": "NEXT WEEK TOO", "on": [0, 1, 2, 3], "off": [4], "progress": 1, "enter": { "anim": "pop" } },
        { "type": "stamp", "text": "APPROVED", "size": 130, "x": 560, "y": 920, "rot": -0.14, "color": "#e63946", "enter": { "anim": "stamp", "at": 2.0, "dur": 0.3 } },
        { "type": "label", "text": "SOURCE: AUTONOMY / 4 DAY WEEK GLOBAL, 2023", "font": "mono", "size": 24, "bg": "#111111", "color": "#fdfcf7", "x": 540, "y": 1645, "jitter": 0, "tape": false }
      ]
    }
  ]
}
